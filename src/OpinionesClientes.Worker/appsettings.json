{
  // Cadenas de conexión con autenticación de Windows (Integrated Security):
  // no hay usuario ni contraseña escritos en el archivo.
  "ConnectionStrings": {
    "SitioWebDb": "Server=.\\SQLEXPRESS;Database=SitioWebDB;Integrated Security=True;TrustServerCertificate=True;Application Name=OpinionesClientes.Extraccion",
    "StagingDb": "Server=.\\SQLEXPRESS;Database=OpinionesStagingDB;Integrated Security=True;TrustServerCertificate=True;Application Name=OpinionesClientes.Extraccion"
  },

  // API REST de comentarios de redes sociales.
  // ApiKey va vacía a propósito: se define con User Secrets o con la variable de entorno SocialApi__ApiKey.
  "SocialApi": {
    "BaseUrl": "http://localhost:5080",
    "ApiKey": "",
    "NombreCabeceraApiKey": "X-Api-Key",
    "TamanoPagina": 50,
    "TimeoutSegundos": 30,
    "Reintentos": 4
  },

  // Destino de los datos extraídos: "SqlServer" (tablas stg.*) o "Archivo" (JSON temporales)
  "Staging": {
    "Destino": "SqlServer",
    "Conexion": "StagingDb",
    "CarpetaArchivos": "Staging",
    "LimpiarAntesDeCargar": true,
    "TamanoLoteBulk": 5000,
    "TimeoutSegundos": 120
  },

  // Fuentes de datos. Para agregar una nueva solo se agrega un bloque aquí.
  "Extraccion": {
    "MaxParalelismo": 4,
    "IntervaloMinutos": 0,
    "Fuentes": [
      {
        "Nombre": "EncuestasInternas",
        "Tipo": "Csv",
        "Entidad": "Encuesta",
        "Ruta": "Data/surveys_part1.csv",
        "TablaStaging": "stg.Encuestas"
      },
      {
        "Nombre": "ResenasSitioWeb",
        "Tipo": "BaseDatos",
        "Entidad": "ResenaWeb",
        "Conexion": "SitioWebDb",
        "Consulta": "SELECT IdReview, IdCliente, IdProducto, Fecha, Comentario, Rating FROM dbo.Resenas",
        "TablaStaging": "stg.ResenasWeb"
      },
      {
        "Nombre": "ComentariosRedesSociales",
        "Tipo": "Api",
        "Entidad": "ComentarioSocial",
        "Endpoint": "api/v1/comentarios",
        "TablaStaging": "stg.ComentariosSociales"
      },
      {
        "Nombre": "Clientes",
        "Tipo": "Csv",
        "Entidad": "Cliente",
        "Ruta": "Data/clients.csv",
        "TablaStaging": "stg.Clientes"
      },
      {
        "Nombre": "Productos",
        "Tipo": "Csv",
        "Entidad": "Producto",
        "Ruta": "Data/products.csv",
        "TablaStaging": "stg.Productos"
      },
      {
        "Nombre": "FuentesDatos",
        "Tipo": "Csv",
        "Entidad": "FuenteDatos",
        "Ruta": "Data/fuente_datos.csv",
        "TablaStaging": "stg.FuentesDatos"
      }
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
