<Project>
  <!-- Configuración común a todos los proyectos de la solución -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Permite ejecutar con .NET 9 o 10 si en el equipo no está el runtime 8 -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
</Project>
